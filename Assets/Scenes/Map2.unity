  m_Name: 
  m_EditorClassIdentifier: 
  noteContent: "\u0E04\u0E37\u0E19\u0E19\u0E35\u0E49\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E40\u0E04\u0E32\u0E30\u0E08\u0E32\u0E01\u0E17\u0E48\u0E2D\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27\n\n\u0E15\u0E2D\u0E19\u0E41\u0E23\u0E01\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E41\u0E23\u0E07\u0E14\u0E31\u0E19\u0E19\u0E49\u0E33
    \u0E41\u0E15\u0E48\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E21\u0E31\u0E19\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u2026\n\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E21\u0E35\u0E04\u0E19\u0E40\u0E04\u0E32\u0E30\u0E15\u0E2D\u0E1A\u0E01\u0E25\u0E31\u0E1A\u0E08\u0E32\u0E01\u0E2D\u0E35\u0E01\u0E1D\u0E31\u0E48\u0E07\n\n\u0E2A\u0E32\u0E21\u0E04\u0E23\u0E31\u0E49\u0E07\n\u0E2B\u0E22\u0E38\u0E14\n\u0E41\u0E25\u0E49\u0E27\u0E2D\u0E35\u0E01\u0E2A\u0E2D\u0E07\u0E04\u0E23\u0E31\u0E49\u0E07\n\n\u0E09\u0E31\u0E19\u0E41\u0E08\u0E49\u0E07\u0E1D\u0E48\u0E32\u0E22\u0E27\u0E34\u0E28\u0E27\u0E01\u0E23\u0E23\u0E21\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\n\u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E43\u0E04\u0E23\u0E2D\u0E22\u0E32\u0E01\u0E25\u0E07\u0E44\u0E1B\u0E15\u0E23\u0E27\u0E08\u0E0A\u0E31\u0E49\u0E19\u0E25\u0E48\u0E32\u0E07\u0E15\u0E2D\u0E19\u0E01\u0E25\u0E32\u0E07\u0E04\u0E37\u0E19"
